# Discord OAuth2 application
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-RENDER-DOMAIN.onrender.com/oauth/callback

# Dashboard session
SESSION_SECRET=change-me

# Bot -> website bridge; set the same secret on Render and KataBump.
NIGHTFALL_WEBSITE_URL=https://YOUR-RENDER-DOMAIN.onrender.com
NIGHTFALL_BRIDGE_SECRET=use-the-same-long-random-secret-on-both
